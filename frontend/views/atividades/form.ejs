<!-- views/atividades/form.ejs — cadastro/edição de atividade, só responsável (a preencher) -->
<%
    const a = locals.atividade || {};
    const editando = !!a.id;
    const categorias = locals.categorias || [];
%>
<%- include('../partials/header', { titulo: editando ? 'Editar atividade' : 'Nova atividade' }) %>
<%- include('../partials/nav', { pagina: 'painel' }) %>

<main>

    <section class="page-header">
        <a href="/painel" class="link-card voltar">← Voltar ao painel</a>
        <h1><%= editando ? 'Editar atividade' : 'Nova atividade' %></h1>
        <p>Preencha os dados abaixo. Apenas responsáveis podem cadastrar e editar atividades.</p>
    </section>

    <section class="conteudo">

        <div class="conteudo-estreito">

            <div id="mensagem" class="mensagem mensagem-erro" role="alert"></div>

            <form class="bloco" id="form-atividade" data-atividade-id="<%= a.id || '' %>"
                  method="post" action="<%= editando ? '/atividades/' + a.id : '/atividades' %>">

                <div class="campo">
                    <label for="nome">Nome da atividade</label>
                    <input type="text" id="nome" name="nome" required
                           placeholder="Ex.: Clube de xadrez" value="<%= a.nome || '' %>">
                </div>

                <div class="campo">
                    <label for="descricao">Descrição</label>
                    <textarea id="descricao" name="descricao"
                              placeholder="Conte o que será feito, para quem é e o que levar."><%= a.descricao || '' %></textarea>
                </div>

                <div class="campos-linha">

                    <div class="campo">
                        <label for="categoria_id">Categoria</label>
                        <select id="categoria_id" name="categoria_id" required>
                            <option value="" disabled <%= a.categoria_id ? '' : 'selected' %>>Selecione</option>
                            <% categorias.forEach(function (c) { %>
                                <option value="<%= c.id %>" <%= Number(a.categoria_id) === Number(c.id) ? 'selected' : '' %>><%= c.nome %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="campo">
                        <label for="vagas">Número de vagas</label>
                        <input type="number" id="vagas" name="vagas" min="0" required
                               value="<%= a.vagas !== undefined ? a.vagas : 10 %>">
                    </div>

                </div>

                <div class="campos-linha">

                    <div class="campo">
                        <label for="local">Local</label>
                        <input type="text" id="local" name="local"
                               placeholder="Ex.: Sala 12" value="<%= a.local || '' %>">
                    </div>

                    <div class="campo">
                        <label for="horario">Horário</label>
                        <input type="text" id="horario" name="horario"
                               placeholder="Ex.: Terças, 14h" value="<%= a.horario || '' %>">
                    </div>

                </div>

                <% if (editando) { %>
                    <div class="campo">
                        <label for="status">Status</label>
                        <select id="status" name="status">
                            <option value="ativa" <%= a.status !== 'inativa' ? 'selected' : '' %>>Ativa</option>
                            <option value="inativa" <%= a.status === 'inativa' ? 'selected' : '' %>>Inativa</option>
                        </select>
                    </div>
                <% } %>

                <div class="form-acoes">
                    <button type="submit" class="botao">
                        <%= editando ? 'Salvar alterações' : 'Cadastrar atividade' %>
                    </button>
                    <a href="/painel" class="botao botao-secundario">Cancelar</a>
                </div>

            </form>

        </div>

    </section>

</main>

<%- include('../partials/footer', { script: 'cadastro-atividade' }) %>