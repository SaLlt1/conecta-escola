<%
    const atual = locals.pagina || '';
    const ativo = (nome) => atual === nome ? ' class="ativo"' : '';
%>
<header class="site-header">
    <div class="logo">
        <a href="/" aria-label="Conecta Escola - início">
            <svg class="logo-icon" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="20" cy="20" r="19" fill="none" stroke="#F2F4F6" stroke-width="1.5"/>
                <path d="M27 13.5A10 10 0 1 0 27 26.5" fill="none" stroke="#F2F4F6" stroke-width="3" stroke-linecap="round"/>
                <circle cx="28.5" cy="20" r="3" fill="#789DC2"/>
            </svg>
            <span class="logo-text">conecta<span class="logo-light">escola</span></span>
        </a>
    </div>
    <nav aria-label="Navegação principal">
        <a href="/"<%- ativo('inicio') %>>Início</a>
        <a href="/atividades"<%- ativo('atividades') %> hidden>Atividades</a>
        <a href="/inscricoes"<%- ativo('inscricoes') %> hidden>Minhas inscrições</a>
        <a href="/painel"<%- ativo('painel') %> hidden>Painel</a>
        <a href="/login"<%- ativo('login') %>>Login</a>
    </nav>
    <a href="/atividades" class="nav-cta">Encontre sua atividade</a>
</header>