<!-- views/auth/registro.ejs -->
<%- include('../partials/header', { titulo: 'Cadastro' }) %>
<%- include('../partials/nav', { pagina: 'login' }) %>

<main>

    <section class="auth">

        <div class="auth-card">

            <h1>Crie sua conta</h1>
            <p>Use o e-mail institucional. Não pedimos idade, telefone, endereço nem foto.</p>

            <div id="mensagem" class="mensagem mensagem-erro" role="alert"></div>

            <form id="form-registro" method="post" action="/auth/registrar">

                <div class="campo">
                    <label for="nome">Nome</label>
                    <input type="text" id="nome" name="nome"
                           placeholder="Seu nome" required autocomplete="name">
                </div>

                <div class="campo">
                    <label for="email">E-mail institucional</label>
                    <input type="email" id="email" name="email_institucional"
                           placeholder="nome@escola.edu.br" required autocomplete="email">
                </div>

                <div class="campo">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha"
                           placeholder="Mínimo de 6 caracteres" minlength="6" required autocomplete="new-password">
                </div>

                <div class="campos-linha">

                    <div class="campo">
                        <label for="papel">Eu sou</label>
                        <select id="papel" name="papel" required>
                            <option value="aluno">Aluno</option>
                            <option value="responsavel">Responsável por atividade</option>
                        </select>
                    </div>

                    <div class="campo">
                        <label for="turma">Turma</label>
                        <input type="text" id="turma" name="turma" placeholder="Ex.: 8º B">
                        <small>Opcional.</small>
                    </div>

                </div>

                <div class="campo" id="campo-codigo" hidden>
                    <label for="codigo_acesso">Código de responsável</label>
                    <input type="password" id="codigo_acesso" name="codigo_acesso"
                           placeholder="Fornecido pela coordenação" autocomplete="off">
                    <small>Necessário apenas para professores e coordenação.</small>
                </div>

                <button type="submit" class="botao botao-bloco">Criar conta</button>

            </form>

            <p class="auth-rodape">
                Já tem conta?
                <a href="/login" class="link-card">Entrar</a>
            </p>

        </div>

    </section>

</main>

<script>
    // Mostra o campo do código só quando o usuário escolhe "Responsável".
    (function () {
        var papel = document.getElementById("papel");
        var campo = document.getElementById("campo-codigo");
        if (!papel || !campo) return;

        function atualizar() {
            var ehResponsavel = papel.value === "responsavel";
            campo.hidden = !ehResponsavel;
            if (!ehResponsavel) document.getElementById("codigo_acesso").value = "";
        }

        papel.addEventListener("change", atualizar);
        atualizar();
    })();
</script>

<%- include('../partials/footer', { script: 'login' }) %>
